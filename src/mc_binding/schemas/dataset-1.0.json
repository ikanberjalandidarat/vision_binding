{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recorded binding dataset 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "backend",
    "is_minecraft",
    "families"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "is_minecraft": {
      "type": "boolean"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "family_id",
          "split",
          "seed",
          "target_side",
          "contexts"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "family_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "seed": {
            "type": "integer"
          },
          "split": {
            "enum": [
              "debug",
              "calibration",
              "test"
            ]
          },
          "target_side": {
            "enum": [
              "left",
              "right"
            ]
          },
          "contexts": {
            "type": "object",
            "required": [
              "recipient",
              "disjoint"
            ],
            "additionalProperties": false,
            "properties": {
              "recipient": {
                "type": "object",
                "required": [
                  "objects",
                  "image",
                  "image_sha256",
                  "width",
                  "height",
                  "render",
                  "camera",
                  "actual_pose",
                  "arena"
                ],
                "properties": {
                  "objects": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "object",
                      "required": [
                        "object_id",
                        "color",
                        "type",
                        "blocks",
                        "bounds",
                        "bbox"
                      ],
                      "properties": {
                        "object_id": {
                          "type": "string"
                        },
                        "color": {
                          "enum": [
                            "red",
                            "blue",
                            "green",
                            "yellow"
                          ]
                        },
                        "type": {
                          "enum": [
                            "tower",
                            "arch",
                            "stairs",
                            "pillar"
                          ]
                        },
                        "bbox": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 4,
                          "maxItems": 4
                        },
                        "blocks": {
                          "type": "array",
                          "minItems": 1
                        }
                      }
                    }
                  },
                  "image": {
                    "type": "string"
                  },
                  "image_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "render": {
                    "type": "object",
                    "required": [
                      "is_minecraft",
                      "backend"
                    ],
                    "properties": {
                      "is_minecraft": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              },
              "disjoint": {
                "type": "object",
                "required": [
                  "objects",
                  "image",
                  "image_sha256",
                  "width",
                  "height",
                  "render",
                  "camera",
                  "actual_pose",
                  "arena"
                ],
                "properties": {
                  "objects": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "object",
                      "required": [
                        "object_id",
                        "color",
                        "type",
                        "blocks",
                        "bounds",
                        "bbox"
                      ],
                      "properties": {
                        "object_id": {
                          "type": "string"
                        },
                        "color": {
                          "enum": [
                            "red",
                            "blue",
                            "green",
                            "yellow"
                          ]
                        },
                        "type": {
                          "enum": [
                            "tower",
                            "arch",
                            "stairs",
                            "pillar"
                          ]
                        },
                        "bbox": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 4,
                          "maxItems": 4
                        },
                        "blocks": {
                          "type": "array",
                          "minItems": 1
                        }
                      }
                    }
                  },
                  "image": {
                    "type": "string"
                  },
                  "image_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "render": {
                    "type": "object",
                    "required": [
                      "is_minecraft",
                      "backend"
                    ],
                    "properties": {
                      "is_minecraft": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
